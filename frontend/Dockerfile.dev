FROM node:22-alpine

# Set Working Directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install Dependencies
RUN npm install

# Copy Project
COPY . .

# Expose Vite Port
EXPOSE 5173

ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

# Start Vite Development Server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]