# =============================================================================
# Search "ENV:LOCAL" or "ENV:LIVE" to switch.
# Local e thakle  -> ENV:LOCAL uncomment, ENV:LIVE comment
# Live e tulle    -> ENV:LIVE uncomment, ENV:LOCAL comment
# Copy to .env and edit. Switch er por: php artisan config:clear
# =============================================================================

# --- ENV:LOCAL ---
APP_NAME="3G Deco"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=3gdeco
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info.codeinqtech@gmail.com
MAIL_PASSWORD=pblhfnyjxbknrlpx
MAIL_FROM_ADDRESS="info.codeinqtech@gmail.com"
MAIL_FROM_NAME="3G Decorative Group"
ENQUIRY_OTP_TTL_MINUTES=10
# Leave empty to send real OTP emails (set e.g. 999999 only for local testing without SMTP)
ENQUIRY_TEST_OTP=
ENQUIRY_OTP_FROM_ADDRESS="info.codeinqtech@gmail.com"
ENQUIRY_OTP_FROM_NAME="3G Decorative Group"
# Change-password OTP (falls back to ENQUIRY_* when unset)
CHANGE_PASSWORD_OTP_TTL_MINUTES=10
CHANGE_PASSWORD_TEST_OTP=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

SEED_SUPER_EMAIL=super@3gdeco.com
SEED_SUPER_PASSWORD=Super@123
SEED_ADMIN_EMAIL=admin@3gdeco.com
SEED_ADMIN_PASSWORD=Admin@123
# --- ENV:LOCAL ---


